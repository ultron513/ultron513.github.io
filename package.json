{
  "name": "ashish-patra-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm validate:content && next build",
    "start": "node scripts/serve-out.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:content": "node --experimental-strip-types --no-warnings scripts/validate-content.mts",
    "check:contrast": "node --experimental-strip-types --no-warnings scripts/check-contrast.mts",
    "images": "node --experimental-strip-types --no-warnings scripts/optimise-images.mts",
    "test:visual": "playwright test",
    "og": "node --experimental-strip-types --no-warnings scripts/generate-og.mts",
    "map": "node --experimental-strip-types --no-warnings scripts/generate-world-map.mts"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.12",
    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1",
    "three": "^0.185.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.185.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.23",
    "prettier": "^3.6.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.6"
  }
}
